---
// Genesis credential + maintainer credential + repo links + license.
// Copy: docs/growth/copy/hero.md ("Genesis + footer band").
const year = new Date().getFullYear();
---

<footer
  class="border-t border-token mt-6"
  style="background: var(--bg);"
>
  <div class="mx-auto max-w-7xl px-6 py-8 md:px-10 md:py-10">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="max-w-md">
        <p class="text-sm text-[var(--text-muted)] leading-relaxed">
          Stewarded by <a
            href="https://www.linkedin.com/in/foadshafighi/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--text-muted)] hover:text-[var(--accent-warm)] transition-colors underline underline-offset-4"
          >Foad Shafighi</a>, MIES IALD CLD.
        </p>
      </div>

      <div class="grid gap-2 md:justify-self-end text-sm md:max-w-md">
        <a
          href="https://github.com/ulcspec/ULC"
          rel="noopener external"
          class="text-[var(--text-muted)] hover:text-[var(--accent-warm)] transition-colors inline-flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5"
        >
          <span>Specification on GitHub:</span>
          <code class="font-mono break-all">github.com/ulcspec/ULC</code>
          <span aria-hidden="true">↗</span>
        </a>
        <a
          href="https://github.com/ulcspec/ulcspec.org"
          rel="noopener external"
          class="text-[var(--text-muted)] hover:text-[var(--accent-warm)] transition-colors inline-flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5"
        >
          <span>Site source:</span>
          <code class="font-mono break-all">github.com/ulcspec/ulcspec.org</code>
          <span aria-hidden="true">↗</span>
        </a>
        <p class="text-[var(--text-muted)]">MIT-licensed.</p>
      </div>
    </div>

    <p class="mt-6 text-xs text-[var(--text-subtle)]">
      © {year} ULC contributors. The Universal Luminaire Cutsheet specification
      is an open standard.
    </p>
  </div>
</footer>
