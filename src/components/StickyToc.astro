---
// In-page TOC for long-form documentation routes. Sticky on desktop ≥1024px,
// collapsed inside <details> on mobile.
//
// Scroll-spy via IntersectionObserver: the link to the section closest to the
// top of the viewport gets aria-current="location". Respects
// prefers-reduced-motion: smooth-scroll is the browser default, no JS animates
// scroll position.

interface Item {
  href: string;
  label: string;
}

interface Props {
  items: Item[];
  label?: string;
}

const { items, label = 'On this page' } = Astro.props;
---

{/* Mobile: collapsible <details> at the top of the page */}
<details class="toc-mobile">
  <summary>
    <span class="toc-mobile__label">{label}</span>
    <svg
      class="toc-mobile__chev"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </summary>
  <nav aria-label={label}>
    <ul class="toc-mobile__list">
      {items.map((item, i) => (
        <li>
          <a href={item.href} class="toc-link" data-toc-link={item.href}>
            <span class="toc-num">{String(i + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</details>

<aside class="toc-desktop" aria-label={label}>
  <p class="toc-desktop__label">{label}</p>
  <nav>
    <ul>
      {items.map((item, i) => (
        <li>
          <a href={item.href} class="toc-link" data-toc-link={item.href}>
            <span class="toc-num">{String(i + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<style>
  /* Mobile: inline collapsible accordion at the top of the page */
  .toc-mobile {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-elevated);
    padding: 0.125rem 1rem;
    margin: 0;
  }
  @media (min-width: 1024px) {
    .toc-mobile {
      display: none;
    }
  }
  .toc-mobile > summary {
    list-style: none;
    cursor: pointer;
    padding: 0.875rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .toc-mobile > summary::-webkit-details-marker {
    display: none;
  }
  .toc-mobile__label {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    color: var(--text-subtle);
  }
  .toc-mobile__chev {
    color: var(--text-muted);
    transition: transform 200ms ease-out;
  }
  .toc-mobile[open] .toc-mobile__chev {
    transform: rotate(180deg);
  }
  .toc-mobile__list {
    list-style: none;
    margin: 0 0 0.75rem 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .toc-mobile__list .toc-link {
    min-height: 44px;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--border);
    align-items: center;
  }
  .toc-mobile__list li:last-child .toc-link {
    border-bottom: none;
  }

  /* Desktop: sticky sidebar inside the page grid */
  .toc-desktop {
    display: none;
  }
  @media (min-width: 1024px) {
    .toc-desktop {
      display: block;
      position: sticky;
      top: 6rem;
      max-height: calc(100dvh - 8rem);
      overflow-y: auto;
      padding-right: 1rem;
    }
  }
  .toc-desktop__label {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    color: var(--text-subtle);
    margin: 0 0 0.75rem 0;
  }
  .toc-desktop ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }
  .toc-desktop li {
    padding: 0;
  }
  .toc-desktop .toc-link {
    padding: 0.375rem 0 0.375rem 1rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
  }

  /* Shared link treatment */
  .toc-link {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 150ms ease-out;
    line-height: 1.5;
  }
  .toc-link:hover {
    color: var(--accent-warm);
  }
  .toc-num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-subtle);
    width: 1.5rem;
    flex-shrink: 0;
  }
  .toc-link[aria-current='location'] {
    color: var(--text);
    border-left-color: var(--accent-warm);
  }
  .toc-link[aria-current='location'] .toc-num {
    color: var(--accent-warm);
  }
</style>

<script>
  // Scroll-spy: mark the link to the current visible section as aria-current.
  // Uses IntersectionObserver with a rootMargin tuned so a section becomes
  // "current" when its top crosses the upper third of the viewport.
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')
  );
  if (links.length > 0 && 'IntersectionObserver' in window) {
    const linkMap = new Map<string, HTMLAnchorElement[]>();
    for (const link of links) {
      const href = link.dataset.tocLink ?? link.getAttribute('href') ?? '';
      const id = href.startsWith('#') ? href.slice(1) : '';
      if (!id) continue;
      const list = linkMap.get(id) ?? [];
      list.push(link);
      linkMap.set(id, list);
    }

    const ids = Array.from(linkMap.keys());
    const sectionEls = ids
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const visible = new Set<string>();

    const setCurrent = (id: string | null) => {
      for (const link of links) {
        link.removeAttribute('aria-current');
      }
      if (!id) return;
      const targets = linkMap.get(id) ?? [];
      for (const t of targets) {
        t.setAttribute('aria-current', 'location');
      }
    };

    const pickCurrent = () => {
      // Pick the highest-on-the-page visible section.
      let bestId: string | null = null;
      let bestTop = Infinity;
      for (const el of sectionEls) {
        if (!visible.has(el.id)) continue;
        const rect = el.getBoundingClientRect();
        if (rect.top < bestTop) {
          bestTop = rect.top;
          bestId = el.id;
        }
      }
      if (bestId) {
        setCurrent(bestId);
      } else {
        // Nothing currently visible (e.g. between sections); keep the most
        // recently-seen section highlighted by leaving aria-current as-is.
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            visible.add(entry.target.id);
          } else {
            visible.delete(entry.target.id);
          }
        }
        pickCurrent();
      },
      {
        // Top of the viewport region considered "current" sits between the
        // sticky nav (~64px) and one-third of the viewport down.
        rootMargin: '-72px 0px -66% 0px',
        threshold: 0,
      }
    );

    for (const el of sectionEls) {
      observer.observe(el);
    }
  }
</script>
