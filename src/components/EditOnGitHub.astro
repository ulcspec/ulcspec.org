---
// EditOnGitHub: "Edit this page on GitHub" footer link, single-surface
// (/spec/*) consumer of the SPEC_SYNC edit-branch helper.
//
// Routes contributors to the upstream MAIN branch of the source file
// (per spec.md "Edit this page on GitHub target: main branch"). The
// page passes the upstream path; this component builds the URL.
//
// JSDoc-marked single-surface per chrome-extraction discipline.

import { editOnGitHubUrl } from '../lib/spec-sync';

interface Props {
  /**
   * Upstream path inside the spec repo, e.g.
   * "docs/authoring-patterns.md" or "schema/ulc.schema.json".
   * Pages typically pull this from manifestEntryForRoute().
   */
  upstreamPath: string;
  /** Optional anchor (e.g. for a specific heading); appended as #id. */
  anchor?: string;
}

const { upstreamPath, anchor } = Astro.props;
const url = editOnGitHubUrl(upstreamPath) + (anchor ? `#${anchor}` : '');
---

<p class="edit-on-github">
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="edit-on-github__link"
  >
    <svg
      aria-hidden="true"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 20h9" />
      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
    </svg>
    <span>Edit this page on GitHub</span>
  </a>
</p>

<style>
  .edit-on-github {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--text-subtle);
  }
  .edit-on-github__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    text-decoration: none;
    min-height: 44px;
    padding: 0.5rem 0;
    transition: color 150ms ease-out;
  }
  .edit-on-github__link:hover {
    color: var(--accent-warm);
  }
  @media print {
    .edit-on-github {
      display: none;
    }
  }
</style>
