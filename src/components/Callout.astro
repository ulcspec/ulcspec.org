---
// Boxed aside for return-to-theme lines, "what is NOT" callouts, provenance
// notes, etc. Three intents:
//   - default   subtle elevated panel, neutral
//   - accent    accent-amber left border, signals a load-bearing line
//   - warning   muted-amber tint, signals a do-not (used for "What is NOT")

type Intent = 'default' | 'accent' | 'warning';

interface Props {
  intent?: Intent;
  label?: string;
  class?: string;
}

const { intent = 'default', label, class: extraClass = '' } = Astro.props;
---

<aside class={`callout callout--${intent} ${extraClass}`.trim()}>
  {label && <p class="callout__label">{label}</p>}
  <div class="callout__body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin-top: 1.5rem;
  }
  .callout--accent {
    border-left: 3px solid var(--accent-warm);
  }
  .callout--warning {
    background: color-mix(in oklab, var(--accent-warm) 6%, var(--bg-elevated));
    border-color: color-mix(in oklab, var(--accent-warm) 30%, var(--border));
  }
  .callout__label {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    color: var(--text-subtle);
    margin: 0 0 0.5rem 0;
  }
  .callout__body :global(p) {
    margin: 0;
  }
  .callout__body :global(p + p) {
    margin-top: 0.75rem;
  }
  .callout__body :global(code) {
    font-family: var(--font-mono);
    color: var(--accent-warm);
    font-size: 0.95em;
  }
</style>
