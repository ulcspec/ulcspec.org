---
// Step 4 marketecture: before/after the designer's spec workflow.
// Two columns. Designer is the protagonist in both. Inline HTML/CSS, themeable.
//
// Single-surface consumer as of 2026-05-16 (/for-designers only). The kept /
// added / bleeds-hours buckets are designer-track wording. Promote to a
// reusable figure component only when a second surface (likely
// /for-manufacturers with the protagonist rotated to manufacturer publishing)
// needs the same structure.

const before = {
  kept: ['PDF datasheets', 'IES files', 'Manufacturer rep relationship'],
  bottlenecks: [
    'Twelve PDFs open at once',
    'Drift-prone firm library',
    'Rep as data bottleneck',
    'Six-hour cross-referencing pass',
  ],
};

const after = {
  kept: ['PDF datasheets', 'IES files', 'Manufacturer rep relationship'],
  added: [
    'Consume ULC files directly',
    'Per-field provenance (SHA-256)',
    'Apples-to-apples comparison in your tools',
    'Luminaire schedule generates from the list',
  ],
};
---

<figure class="ba-fig">
  <div class="ba-grid" role="img" aria-label="Before and after the designer's spec workflow. Before: PDFs, IES files, and rep relationships stay, but six-hour cross-referencing, drift-prone firm library, and rep-as-data-bottleneck eat hours. After: same PDFs, IES files, and rep relationships, plus direct ULC consumption, per-field provenance, apples-to-apples comparison, and generated luminaire schedules.">
    <article class="ba-col ba-col--before">
      <header>
        <p class="ba-col__eyebrow">Today</p>
        <h3 class="ba-col__title">PDF + library + rep, with bleed</h3>
      </header>
      <div class="ba-section">
        <p class="ba-section__label">Kept</p>
        <ul class="ba-list">
          {before.kept.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <div class="ba-section ba-section--bleed">
        <p class="ba-section__label">Bleeds hours</p>
        <ul class="ba-list">
          {before.bottlenecks.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </article>

    <div class="ba-arrow" aria-hidden="true">
      <svg viewBox="0 0 40 24" width="40" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 12h34M26 4l10 8-10 8" />
      </svg>
    </div>

    <article class="ba-col ba-col--after">
      <header>
        <p class="ba-col__eyebrow">With ULC</p>
        <h3 class="ba-col__title">PDF + library + rep, plus the data layer</h3>
      </header>
      <div class="ba-section">
        <p class="ba-section__label">Kept</p>
        <ul class="ba-list">
          {after.kept.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <div class="ba-section ba-section--gain">
        <p class="ba-section__label">Added</p>
        <ul class="ba-list">
          {after.added.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </article>
  </div>
  <figcaption class="ba-cap">
    Before and after, from the designer's seat. The PDF stays beautiful for human reading; the ULC record stays accurate for machine reading.
  </figcaption>
</figure>

<style>
  .ba-fig {
    margin: 2rem 0 0 0;
  }
  .ba-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: stretch;
  }
  @media (min-width: 1024px) {
    .ba-grid {
      grid-template-columns: 1fr auto 1fr;
      gap: 1.25rem;
    }
  }
  .ba-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    background: var(--bg-elevated);
  }
  .ba-col--after {
    border-color: color-mix(in oklab, var(--accent-warm) 35%, var(--border));
  }
  .ba-col__eyebrow {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
    color: var(--text-subtle);
    margin: 0 0 0.375rem 0;
  }
  .ba-col__title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.35;
    margin: 0;
  }
  .ba-section__label {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    font-size: 0.6875rem;
    color: var(--text-subtle);
    margin: 0 0 0.375rem 0;
  }
  .ba-section--bleed .ba-section__label {
    color: var(--accent-warm);
  }
  .ba-section--gain .ba-section__label {
    color: var(--accent-warm);
  }
  .ba-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .ba-list li {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.4;
    padding-left: 0.875rem;
    position: relative;
  }
  .ba-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--text-subtle);
  }
  .ba-section--bleed .ba-list li::before,
  .ba-section--gain .ba-list li::before {
    background: var(--accent-warm);
  }
  .ba-arrow {
    color: var(--accent-warm);
    align-self: center;
    justify-self: center;
    padding: 0.5rem;
    display: none;
  }
  @media (min-width: 1024px) {
    .ba-arrow {
      display: block;
    }
  }
  .ba-cap {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--text-subtle);
    line-height: 1.5;
  }
</style>
