---
import logo from '../assets/logo.png';
import Button from './Button.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** Override the active-route detection. Defaults to the request pathname. */
  current?: string;
}

const { current = Astro.url.pathname } = Astro.props;

const links = [
  { href: '/for-designers', label: 'For Designers' },
  { href: '/for-manufacturers', label: 'For Manufacturers' },
  { href: '/validator', label: 'Validator' },
  { href: '/spec', label: 'Spec' },
  { href: '/governance', label: 'Governance' },
  { href: '/downloads', label: 'Downloads' },
] as const;

const isActive = (href: string) =>
  current === href ||
  (href !== '/' && (current === href || current.startsWith(href + '/')));
---

<header
  class="sticky top-0 z-40 backdrop-blur-md border-b border-token"
  style="background: var(--bg-translucent);"
>
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 md:px-10"
  >
    <a
      href="/"
      class="flex items-center gap-3 shrink-0 rounded-full"
      aria-label="ULC home"
    >
      <img
        src={logo.src}
        width="40"
        height="40"
        alt=""
        loading="eager"
        decoding="async"
        class="h-10 w-10 rounded-full"
      />
    </a>

    <ul
      class="hidden lg:flex items-center gap-7 text-sm font-medium tracking-tight"
    >
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={`transition-colors hover:text-[var(--accent-warm)] ${
              isActive(href)
                ? 'text-[var(--text)]'
                : 'text-[var(--text-muted)]'
            }`}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <ThemeToggle />
      <Button
        variant="ghost"
        size="icon"
        id="nav-toggle"
        ariaControls="mobile-menu"
        ariaExpanded="false"
        class="lg:hidden"
      >
        <span class="sr-only">Open menu</span>
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
        >
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </Button>
    </div>
  </nav>

  <nav
    id="mobile-menu"
    hidden
    aria-label="Mobile"
    class="lg:hidden border-t border-token"
    style="background: var(--bg);"
  >
    <ul class="mx-auto max-w-7xl px-6 py-4 flex flex-col text-base">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={`flex items-center min-h-[44px] py-2 ${
              isActive(href)
                ? 'text-[var(--text)] font-semibold'
                : 'text-[var(--text-muted)]'
            }`}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  function closeMenu() {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', 'false');
    menu.hidden = true;
  }
  if (btn && menu) {
    btn.addEventListener('click', (event) => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      menu.hidden = open;
      // Keyboard activation (Enter/Space) reports detail === 0; pointer
      // activation reports detail > 0. Only move focus into the menu on
      // keyboard activation so touch users aren't teleported.
      if (!open && event.detail === 0) {
        const firstLink = menu.querySelector<HTMLAnchorElement>('a');
        firstLink?.focus();
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        btn.focus();
      }
    });
  }
</script>
