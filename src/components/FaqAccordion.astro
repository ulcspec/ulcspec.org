---
// Zero-JS FAQ accordion using native <details>/<summary>. Each Q&A is anchor-
// linkable via the slug-derived id. Collapsed by default. Print stylesheet
// forces every <details> open.
//
// The data shape lets the page author the four objection answers as rich
// HTML strings; for richer layouts use the <slot/>-overload variant below.

interface Item {
  id: string;
  question: string;
  /**
   * Trusted HTML rendered via `set:html`. Content MUST be repo-authored
   * (e.g. literal strings in a page frontmatter or content collection); never
   * pass user-supplied input here; this is an XSS surface if the contract
   * breaks. If a third `set:html` consumer materializes, promote to a
   * `TrustedHtml` branded type in `src/lib/trusted-html.ts`.
   */
  answerHtml: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {items.map((item) => (
    <details id={item.id} class="faq-item">
      <summary>
        <h3 class="faq-item__q">{item.question}</h3>
        <span class="faq-item__chev" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </summary>
      <div class="faq-item__a" set:html={item.answerHtml} />
    </details>
  ))}
</div>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }
  .faq-item {
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 6rem;
  }
  .faq-item > summary {
    list-style: none;
    cursor: pointer;
    padding: 1.25rem 0;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item > summary:hover .faq-item__q,
  .faq-item > summary:focus-visible .faq-item__q {
    color: var(--accent-warm);
  }
  .faq-item > summary:focus-visible {
    outline: 2px solid var(--accent-warm);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .faq-item__q {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
    margin: 0;
    transition: color 150ms ease-out;
  }
  .faq-item__chev {
    color: var(--text-muted);
    transition: transform 200ms ease-out;
    flex-shrink: 0;
    padding-top: 0.125rem;
  }
  .faq-item[open] .faq-item__chev {
    transform: rotate(180deg);
  }
  .faq-item__a {
    padding: 0 0 1.5rem 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 70ch;
  }
  .faq-item__a :global(p) {
    margin: 0;
  }
  .faq-item__a :global(p + p) {
    margin-top: 0.9rem;
  }
  .faq-item__a :global(code) {
    font-family: var(--font-mono);
    color: var(--accent-warm);
    font-size: 0.95em;
  }
  .faq-item__a :global(a) {
    color: var(--accent-warm);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media print {
    .faq-item {
      border: none;
    }
    .faq-item__chev {
      display: none;
    }
    /* Force every <details> open for print. UA stylesheet hides non-summary
       children when the element is closed; the !important override ensures
       all answers render regardless of interactive state. */
    .faq-item > *:not(summary) {
      display: block !important;
    }
    .faq-item > summary {
      cursor: default;
      padding-bottom: 0.5rem;
    }
    .faq-item__a {
      padding-bottom: 0.75rem;
    }
  }
</style>
