---
// Contextual "Learn more" band at the bottom of long-form pages. The consuming
// page provides a short list of page-specific deep links: relevant to that page
// and surfacing buried content (a /docs subpage or a section anchor), never
// header-reachable filler.

interface LinkItem {
  href: string;
  /**
   * Trusted HTML rendered via `set:html` so labels can embed `<code>` for
   * filename references. MUST be repo-authored; never pass user input here.
   * Promote to a `TrustedHtml` branded type on the 3rd `set:html` consumer.
   */
  labelHtml: string;
}

interface Props {
  links: LinkItem[];
  /** Optional eyebrow label above the link grid. */
  label?: string;
}

const { links, label = 'Learn more' } = Astro.props;
---

<section
  class="border-t border-token print:hidden"
  style="background: var(--bg-elevated);"
  aria-labelledby="cross-link-footer-label"
>
  <div class="mx-auto max-w-7xl px-6 py-16 md:px-10 md:py-20">
    <p
      id="cross-link-footer-label"
      class="small-caps text-xs text-[var(--text-subtle)] mb-6"
    >
      {label}
    </p>
    <ul
      class="grid gap-x-8 gap-y-2 md:grid-cols-2 lg:grid-cols-3 text-base"
    >
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="min-h-[44px] py-2 inline-flex items-center gap-2 text-[var(--text)] hover:text-[var(--accent-warm)] transition-colors"
          >
            <span set:html={link.labelHtml} />
            <span aria-hidden="true" class="text-[var(--accent-warm)]">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
