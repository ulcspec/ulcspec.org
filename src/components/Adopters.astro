---
// Adopters landing-page section. Renders empty-state at v1; pivots to a
// card grid when adopters.json populates. Empty-state copy is LOCKED.
// Data source: build-time fetch of ulcspec/ULC adopters.json (future).
//
// Interface field names mirror the upstream JSON shape (camelCase here,
// snake_case there) so the future loader/adapter at src/lib/adopters.ts
// is a 1:1 key translation. See docs/tasks/sections/adopters-plan.md §3.3.

interface Adopter {
  manufacturerName: string;
  productLine: string;
  dateAdopted: string;
  ulcFileUrl: string;
  logoUrl?: string;
  region?: string;
}

// At v1: registry is empty. Future wiring fetches from ulcspec/ULC.
// Empty-state sentence is locked verbatim, rendered inline below.
const adopters: Adopter[] = [];
---

<section id="adopters" class="relative scroll-mt-24">
  <div class="mx-auto max-w-7xl px-6 py-20 md:px-10 md:py-28 lg:py-32">
    <div class="max-w-3xl">
      <h2
        class="font-display text-3xl md:text-4xl font-semibold tracking-tight leading-tight"
      >
        Adopted By
      </h2>
    </div>

    {
      adopters.length === 0 ? (
        <div
          class="mt-12 border border-token rounded-lg py-16 px-8 text-center"
          style="background: var(--bg-elevated);"
        >
          <p class="text-base md:text-lg text-[var(--text-muted)] max-w-xl mx-auto leading-relaxed">
            In active dialogue with industry-leading organizations like IES, LIA and NLB. As well as active pilot programs with lighting manufacturers. The list will populate as manufacturers publish{' '}
            <code class="font-mono text-[var(--text)]">.ulc</code> files for
            their products.
          </p>
        </div>
      ) : (
        <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {adopters.map((a) => (
            <li
              class="border border-token rounded-lg p-6"
              style="background: var(--bg-elevated);"
            >
              <p class="font-semibold text-[var(--text)]">{a.manufacturerName}</p>
              <p class="text-sm text-[var(--text-muted)] mt-1">
                {a.productLine}
              </p>
              <p class="text-xs text-[var(--text-subtle)] mt-2">
                Adopted {a.dateAdopted}
                {a.region && <span class="ml-2">· {a.region}</span>}
              </p>
              <a
                href={a.ulcFileUrl}
                class="text-sm text-[var(--accent-warm)] hover:underline mt-3 inline-block"
              >
                View .ulc file →
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
