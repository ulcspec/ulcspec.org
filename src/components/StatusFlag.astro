---
// StatusFlag: small pill for crosswalk readiness ("planned" / "in
// progress" / "landed"). Three-state vocabulary referenced from the
// spec section (line 89). The "landed" variant uses the accent-warm
// fill; "in-progress" uses a half-mix; "planned" stays neutral so the
// reader's eye is drawn to working crosswalks, not promises.
//
// Single-surface (/spec/crosswalks/*) consumer per chrome-extraction
// discipline. Visually parallel to the proof-status pills on
// /for-manufacturers but semantically distinct, so kept separate.

type Status = 'planned' | 'in-progress' | 'landed';

interface Props {
  status: Status;
  /** Optional override of the visible label (default = status itself). */
  label?: string;
}

const { status, label } = Astro.props;
const visible = label ?? humanize(status);

function humanize(s: Status): string {
  switch (s) {
    case 'planned': return 'Planned';
    case 'in-progress': return 'In progress';
    case 'landed': return 'Landed';
    default: {
      const _exhaustive: never = s;
      throw new Error(`StatusFlag: unhandled status ${String(_exhaustive)}`);
    }
  }
}
---

<span class={`status-flag status-flag--${status}`}>
  <span class="status-flag__dot" aria-hidden="true"></span>
  {visible}
</span>

<style>
  .status-flag {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.1875rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.01em;
    background: var(--bg-elevated);
    color: var(--text-muted);
  }
  .status-flag__dot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 999px;
    background: var(--text-subtle);
    flex-shrink: 0;
  }
  .status-flag--in-progress {
    background: color-mix(in oklab, var(--accent-warm) 6%, var(--bg-elevated));
    border-color: color-mix(in oklab, var(--accent-warm) 30%, var(--border));
    color: var(--text);
  }
  .status-flag--in-progress .status-flag__dot {
    background: color-mix(in oklab, var(--accent-warm) 60%, var(--text-subtle));
  }
  .status-flag--landed {
    background: color-mix(in oklab, var(--accent-warm) 10%, var(--bg-elevated));
    border-color: color-mix(in oklab, var(--accent-warm) 40%, var(--border));
    color: var(--text);
  }
  .status-flag--landed .status-flag__dot {
    background: var(--accent-warm);
  }
</style>
