---
// SectionCard: "How to use ULC today" / "Authoring patterns" /
// "Schema reference" / etc. nav card on the /spec landing page.
// One card per spec content area. The first card (Tier 1 + Tier 2
// activation) gets the accent treatment so it reads as the primary
// landing-page CTA; the remaining six are equal-weight content cards.
//
// Single-surface (/spec landing) consumer. Visually parallel to but
// architecturally distinct from the homepage <Tier1QuickWin> card and
// the for-manufacturers proof-matrix rows.

interface Props {
  href: string;
  title: string;
  /** One-line description. ~80-120 chars target. */
  description: string;
  /** Optional eyebrow above the title (e.g. "Activate" or "Reference"). */
  eyebrow?: string;
  /** Card emphasis. "accent" lifts the card with an accent left border. */
  variant?: 'default' | 'accent';
}

const {
  href,
  title,
  description,
  eyebrow,
  variant = 'default',
} = Astro.props;
---

<a href={href} class={`section-card section-card--${variant}`}>
  {eyebrow && <p class="section-card__eyebrow">{eyebrow}</p>}
  <h3 class="section-card__title">{title}</h3>
  <p class="section-card__description">{description}</p>
  <svg
    class="section-card__arrow"
    aria-hidden="true"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <line x1="5" y1="12" x2="19" y2="12" />
    <polyline points="12 5 19 12 12 19" />
  </svg>
</a>

<style>
  .section-card {
    position: relative;
    display: block;
    padding: 1.5rem 1.75rem 1.75rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-elevated);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 150ms ease-out,
      transform 150ms ease-out,
      background 150ms ease-out;
  }
  .section-card:hover {
    border-color: color-mix(in oklab, var(--accent-warm) 50%, var(--border));
    transform: translateY(-1px);
  }
  .section-card:focus-visible {
    outline: 2px solid var(--accent-warm);
    outline-offset: 3px;
  }

  .section-card--accent {
    border-left: 3px solid var(--accent-warm);
    background: color-mix(in oklab, var(--accent-warm) 4%, var(--bg-elevated));
  }
  .section-card--accent:hover {
    background: color-mix(in oklab, var(--accent-warm) 7%, var(--bg-elevated));
  }

  .section-card__eyebrow {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.1em;
    font-size: 0.6875rem;
    color: var(--accent-warm);
    margin: 0 0 0.5rem 0;
    font-weight: 600;
  }
  .section-card__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.5rem 0;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .section-card__description {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
    padding-right: 2rem;
  }
  .section-card__arrow {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    color: var(--text-subtle);
    transition: color 150ms ease-out, transform 150ms ease-out;
  }
  .section-card:hover .section-card__arrow {
    color: var(--accent-warm);
    transform: translateX(2px);
  }
</style>
