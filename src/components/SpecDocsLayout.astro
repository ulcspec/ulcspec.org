---
// SpecDocsLayout: three-pane docs shell for /spec/* sub-routes.
//
// Composition:
//   - Left rail: <SpecSidebar> (cross-route nav, sticky desktop, mobile accordion)
//   - Main:     default slot (page content, including the version badge,
//               H1, body, EditOnGitHub footer)
//   - Right rail: <slot name="onThisPage" /> for the right-rail mini-TOC,
//                 typically populated by the page with an <OnThisPage>
//                 instance. Visible at ≥1280px only.
//
// Two-pane on tablet (sidebar + main), one-pane on mobile (collapsed
// sidebar accordion above main). The landing page (/spec) typically
// omits the right rail entirely.
//
// Single-surface (/spec/*) consumer per chrome-extraction discipline.

import SpecSidebar from './SpecSidebar.astro';
---

<div class="spec-docs-layout">
  <div class="spec-docs-layout__sidebar">
    <SpecSidebar />
  </div>
  <article class="spec-docs-layout__main">
    <slot />
  </article>
  <div class="spec-docs-layout__rail">
    <slot name="onThisPage" />
  </div>
</div>

<style>
  .spec-docs-layout {
    max-width: 80rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;

    /* Mobile-first: flex column with the main content rendered BEFORE the
       sidebar accordion, so a mobile reader sees the page H1 + intro on
       arrival rather than a "SPEC NAVIGATION" eyebrow. The desktop grid
       overrides this at ≥1024px and renders sidebar in the left column. */
    display: flex;
    flex-direction: column;
  }
  .spec-docs-layout__sidebar { order: 2; }
  .spec-docs-layout__main { order: 1; }
  .spec-docs-layout__rail { display: none; }

  @media (min-width: 768px) {
    .spec-docs-layout {
      padding: 2.5rem 2.5rem 5rem;
    }
  }

  /* Desktop ≥ 1024px: two columns (sidebar + main); restore source order */
  @media (min-width: 1024px) {
    .spec-docs-layout {
      display: grid;
      grid-template-columns: 16rem minmax(0, 1fr);
      column-gap: 3rem;
      align-items: start;
    }
    .spec-docs-layout__sidebar { order: initial; }
    .spec-docs-layout__main { order: initial; }
  }

  /* Wide desktop ≥ 1280px: three columns (sidebar + main + rail) */
  @media (min-width: 1280px) {
    .spec-docs-layout {
      grid-template-columns: 16rem minmax(0, 1fr) 14rem;
      column-gap: 3.5rem;
    }
    .spec-docs-layout__rail {
      display: block;
    }
  }

  .spec-docs-layout__main {
    min-width: 0;
    max-width: 56rem;
  }
</style>
