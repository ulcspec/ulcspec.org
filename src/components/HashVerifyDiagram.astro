---
// /validator mechanism figure: how a SHA-256 source-file hash proves a ULC
// record traces to the manufacturer's real files. The teaching idea is that
// the same one-way function runs twice, on two copies of the same file, at
// two different times (once when the record is authored, once when you
// verify), and the two fingerprints are compared. Equal fingerprints mean
// byte-identical files.
//
// Single-surface consumer as of 2026-06-02 (/validator only). Inline
// HTML/CSS, themeable via the shared token set. Visual headings render as
// <p> so the figure does not emit document-outline headings that compete
// with the surrounding page H2/H3s; the accessible name comes from the
// role="img" + aria-label on the grid.

// Representative truncated SHA-256 fingerprint. Both lanes show the same
// value on purpose: a match is the whole point of the figure.
const sample = '9f86d081…b250e08a';
---

<figure class="hv-fig">
  <div
    class="hv-grid"
    role="img"
    aria-label="How source-file hash verification works. When the record is authored, the manufacturer's source file (a PDF, IES, or LDT) is run through SHA-256 to produce a 64-character fingerprint, which is stored in the record. When you verify, the same file you drop in is run through SHA-256 again, in your browser, producing its own fingerprint. The two fingerprints are compared: if they are identical, this is the exact file the record was built from, unchanged; if they differ, the file and the record disagree."
  >
    {/* Lane A: authoring */}
    <article class="hv-lane">
      <p class="hv-lane__eyebrow">When the record is authored</p>
      <div class="hv-node">
        <p class="hv-node__title">Manufacturer's source file</p>
        <p class="hv-node__sub">A PDF, IES, or LDT. The exact bytes.</p>
      </div>
      <div class="hv-step" aria-hidden="true">
        <svg class="hv-step__arrow" viewBox="0 0 24 28" width="24" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2v20M5 16l7 7 7-7" />
        </svg>
        <span class="hv-step__label">SHA-256</span>
      </div>
      <div class="hv-node hv-node--hash">
        <p class="hv-node__title">Fingerprint, stored in the record</p>
        <p class="hv-node__hash"><code>{sample}</code></p>
        <p class="hv-node__path"><code>source_files[].reference.sha256</code></p>
      </div>
    </article>

    {/* Center: the comparison */}
    <div class="hv-compare" aria-hidden="true">
      <span class="hv-compare__op">=</span>
      <span class="hv-compare__label">compare</span>
    </div>

    {/* Lane B: verifying */}
    <article class="hv-lane">
      <p class="hv-lane__eyebrow">When you verify</p>
      <div class="hv-node">
        <p class="hv-node__title">The file you drop in</p>
        <p class="hv-node__sub">The same PDF, IES, or LDT.</p>
      </div>
      <div class="hv-step" aria-hidden="true">
        <svg class="hv-step__arrow" viewBox="0 0 24 28" width="24" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2v20M5 16l7 7 7-7" />
        </svg>
        <span class="hv-step__label">SHA-256, in your browser</span>
      </div>
      <div class="hv-node hv-node--hash">
        <p class="hv-node__title">Fingerprint, recomputed</p>
        <p class="hv-node__hash"><code>{sample}</code></p>
        <p class="hv-node__path">computed locally, nothing uploaded</p>
      </div>
    </article>
  </div>

  {/* Verdict */}
  <div class="hv-verdict">
    <div class="hv-verdict__cell hv-verdict__cell--match">
      <p class="hv-verdict__label">Match</p>
      <p class="hv-verdict__text">Identical fingerprints. This is the exact file the record was built from, unchanged.</p>
    </div>
    <div class="hv-verdict__cell hv-verdict__cell--mismatch">
      <p class="hv-verdict__label">Mismatch</p>
      <p class="hv-verdict__text">The fingerprints differ. The file and the record disagree; the numbers are not safe to trust.</p>
    </div>
  </div>

  <figcaption class="hv-cap">
    The same one-way function, run on the same file at two different times. If the fingerprints agree, the bytes are identical. No server, and no trust, required.
  </figcaption>
</figure>

<style>
  .hv-fig {
    margin: 2rem 0 0 0;
  }

  .hv-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: stretch;
  }
  @media (min-width: 768px) {
    .hv-grid {
      grid-template-columns: 1fr auto 1fr;
      gap: 1.25rem;
      align-items: center;
    }
  }

  .hv-lane {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    background: var(--bg-elevated);
  }
  .hv-lane__eyebrow {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
    color: var(--text-subtle);
    margin: 0;
  }

  .hv-node {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.75rem 0.875rem;
    background: var(--bg);
  }
  .hv-node--hash {
    border-color: color-mix(in oklab, var(--accent-warm) 35%, var(--border));
  }
  .hv-node__title {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.35;
    margin: 0;
  }
  .hv-node__sub {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin: 0.25rem 0 0 0;
  }
  .hv-node__hash {
    margin: 0.5rem 0 0 0;
  }
  .hv-node__hash code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent-warm);
    overflow-wrap: anywhere;
  }
  .hv-node__path {
    font-size: 0.6875rem;
    color: var(--text-subtle);
    line-height: 1.4;
    margin: 0.375rem 0 0 0;
  }
  .hv-node__path code {
    font-family: var(--font-mono);
    font-size: 0.95em;
    overflow-wrap: anywhere;
  }

  .hv-step {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    padding-left: 0.25rem;
    color: var(--accent-warm);
  }
  .hv-step__arrow {
    flex-shrink: 0;
    /* Down-arrow within a lane reads vertically on every breakpoint. */
  }
  .hv-step__label {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    font-size: 0.6875rem;
    color: var(--text-subtle);
  }

  .hv-compare {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--accent-warm);
  }
  @media (min-width: 768px) {
    .hv-compare {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
  .hv-compare__op {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1;
    color: var(--accent-warm);
  }
  .hv-compare__label {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
    color: var(--text-subtle);
  }

  .hv-verdict {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  @media (min-width: 768px) {
    .hv-verdict {
      grid-template-columns: 1fr 1fr;
    }
  }
  .hv-verdict__cell {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.875rem 1rem;
    background: var(--bg-elevated);
  }
  .hv-verdict__cell--match {
    border-color: color-mix(in oklab, var(--accent-warm) 45%, var(--border));
    background: color-mix(in oklab, var(--accent-warm) 6%, var(--bg-elevated));
  }
  .hv-verdict__label {
    font-weight: 600;
    font-size: 0.875rem;
    margin: 0 0 0.25rem 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hv-verdict__cell--match .hv-verdict__label {
    color: var(--accent-warm);
  }
  .hv-verdict__cell--match .hv-verdict__label::before {
    content: '';
