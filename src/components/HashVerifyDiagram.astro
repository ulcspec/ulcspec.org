    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-warm);
  }
  .hv-verdict__cell--mismatch .hv-verdict__label {
    color: var(--text);
  }
  .hv-verdict__cell--mismatch .hv-verdict__label::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid color-mix(in oklab, var(--accent-warm) 70%, var(--text));
    box-sizing: border-box;
  }
  .hv-verdict__text {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .hv-cap {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--text-subtle);
    line-height: 1.5;
  }

  @media print {
    .hv-fig {
      page-break-inside: avoid;
    }
    .hv-node--hash,
    .hv-verdict__cell--match {
      /* Accent tinting carries the match semantics; force it in print. */
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
