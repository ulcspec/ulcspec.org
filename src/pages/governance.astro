---
// /governance — stewardship credibility + license + industry engagement
// deep-dive. Standards-document register throughout, not SaaS marketing.
// The page is read by industry-body representatives (DIAL / IES / IALD / LIA)
// doing due diligence, manufacturer CEOs landing here with the longevity
// concern from /for-manufacturers Q1, and designers confirming the standard
// is designer-led and openly governed.
//
// Spec:          docs/tasks/sections/governance.md
// Copy:          docs/growth/copy/governance.md
// Storyboards:   docs/growth/sales-pitch-storyboard-manufacturer.md (Step 7),
//                docs/growth/sales-pitch-storyboard-designer.md (Step 7 obj. ii)
// Positioning:   docs/growth/positioning-manufacturer.md + -designer.md
//                (Unique Capability #7: designer-steward; #8: industry engagement)

import PageShell from '../components/PageShell.astro';
import StickyToc from '../components/StickyToc.astro';
import DialogueStrip from '../components/DialogueStrip.astro';
import Callout from '../components/Callout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CrossLinkFooter from '../components/CrossLinkFooter.astro';

const tocItems = [
  { href: '#stewardship', label: 'Stewardship' },
  { href: '#license', label: 'License and governance' },
  { href: '#industry', label: 'Industry engagement' },
  { href: '#genesis', label: 'Genesis' },
  { href: '#pilots', label: 'Pilots' },
  { href: '#faq', label: 'The FAQ' },
];

const faqItems = [
  {
    id: 'q-longevity',
    question: 'Will this be around in 5 years?',
    answerHtml: `<p>Three structural answers. One, MIT license: the standard cannot be captured by any single party. Two, neutral stewardship by a practicing designer; the field set reflects specifier needs, not vendor roadmaps. Three, <code>GOVERNANCE.md</code> plus the Schema Change Proposal process means future schema changes go through open review.</p><p>If the original steward steps away, the standard is structurally able to continue. The MIT license means no single party owns it. The <code>GOVERNANCE.md</code> document defines how stewardship transitions. Anyone can fork. Anyone can become the next steward.</p>`,
  },
  {
    id: 'q-designer-steward',
    question: 'Why a designer-steward and not a trade body?',
    answerHtml: `<p>Trade bodies that govern adjacent standards have commercial software products coupled to their stewardship. That coupling shapes design decisions: which fields get priority, which integration paths get easy paths, which fields stay in the schema. A practicing designer has no such coupling.</p><p>The steward specifies. The standard reflects what specifiers need, not what a planning-tool vendor's roadmap needs.</p>`,
  },
  {
    id: 'q-formal-standards',
    question: "Why isn't this an IEEE, ISO, or CEN standard?",
    answerHtml: `<p>Formal standards bodies (IEEE, ISO, CEN) operate on 5 to 10 year cycles. The AI-mediated specifier-discovery shift is happening now; the data layer needs to exist now for the discovery loop to work. ULC ships the technical artifact today, on the open-standard trajectory and structured to slot into a formal process later if the bodies that govern adjacent layers move toward it.</p><p>The MIT license and the open Schema Change Proposal process mean ULC is structurally compatible with a future formal-standards adoption. The repository, the GOVERNANCE.md, and the SCP history would all carry forward. The current posture is "ship the working spec; let formal-standards alignment be a downstream conversation," not "wait for a body to authorize before publishing."</p>`,
  },
  {
    id: 'q-lightingagent',
    question: "Is this just LightingAgent's data layer with the serial numbers filed off?",
    answerHtml: `<p>Three structural answers. One, the repository is at <code>github.com/ulcspec/ULC</code>, not under any LightingAgent organization. Two, MIT license and open governance: anyone can fork, anyone can submit Schema Change Proposals, anyone can implement a competing consumer. Three, LightingAgent.AI is the first consumer because the same founder built both, and the founder is upfront about that.</p><p>The structural choice was to ship the standard in a neutrally stewarded repo with open governance, not as a LightingAgent-owned format. That choice is permanent at the license layer.</p>`,
  },
  {
    id: 'q-scp',
    question: 'How do schema changes happen?',
    answerHtml: `<p>Schema changes happen through the Schema Change Proposal process. Anyone can file. The flow: file an SCP in the spec repository with the proposed change and rationale; the SCP is reviewed publicly; the maintainer responds with merge, request-for-revision, or rejection with rationale.</p><p>The four canonical reference records in <code>examples/</code> are the structural test fixtures every SCP must continue to validate against. Schema versioning is semver-style; pre-1.0 changes are additive per the ROADMAP.</p>`,
  },
  {
    id: 'q-funding',
    question: 'How is this funded, and what happens if funding goes away?',
    answerHtml: `<p>ULC is not funded. There is no commercial entity, no SaaS layer, no subscription. The steward maintains it as part of the same professional practice that informs the field set.</p><p>The MIT license means the standard is structurally portable: if the original steward stops maintaining it, anyone can fork and continue. There is no funding line for anything to "go away with".</p>`,
  },
];

// Crosswalk status table. Values are honest pre-launch: all four are
// "planned" at v1. As a crosswalk lands in ulcspec/ULC (e.g.
// gldf-crosswalk.md ships), the corresponding row flips planned → landed.
// Section spec §Edge Cases row 2 documents this content-update trigger.
type CrosswalkStatus = 'planned' | 'in-progress' | 'landed';

interface CrosswalkRow {
  format: string;
  governedBy: string;
  status: CrosswalkStatus;
}

// Exhaustive Record lookup so a new CrosswalkStatus variant fails the
// type-check until a label is added. Mirrors the proofRows pattern in
// /for-manufacturers (the "third surface, same shape" discipline).
const crosswalkStatusLabels: Record<CrosswalkStatus, string> = {
  planned: 'Planned',
  'in-progress': 'In progress',
  landed: 'Landed',
};

const crosswalks: readonly CrosswalkRow[] = [
  { format: 'GLDF', governedBy: 'DIAL', status: 'planned' },
  { format: 'ETIM', governedBy: 'ETIM International', status: 'planned' },
  { format: 'IES LM-63', governedBy: 'IES', status: 'planned' },
  { format: 'EULUMDAT', governedBy: 'industry de-facto', status: 'planned' },
];

// Cross-link footer destinations. The /spec and /spec#crosswalks entries
// route to a surface not yet shipped (hero PR-2 routing stubs). To avoid
// 404s on a credibility surface read by industry-body reviewers, the
// crosswalk reference points at the upstream repo directly until /spec
// lands. When /spec ships, swap the upstream link back to /spec#crosswalks.
const crossLinks = [
  { href: '/for-designers', labelHtml: 'Designer track: who ULC is for and how to try it today' },
  { href: '/for-manufacturers', labelHtml: 'Manufacturer track: publish a ULC pilot' },
  { href: '/spec', labelHtml: 'Authoring patterns and schema reference' },
  { href: 'https://github.com/ulcspec/ULC/tree/main/crosswalks', labelHtml: 'Crosswalk reference: GLDF, ETIM, LM-63, EULUMDAT' },
  { href: '/#adopters', labelHtml: 'The canonical adopters register' },
  { href: 'https://github.com/ulcspec/ULC', labelHtml: 'Specification and source: <code>github.com/ulcspec/ULC</code>' },
];

const pageTitle = 'ULC stewardship, license, and industry engagement';
const pageDescription = 'Open standard, MIT-licensed, neutrally stewarded by a practicing lighting designer. Introduced at the National Lighting Bureau AI Think Tank 2026.';
---

<PageShell title={pageTitle} description={pageDescription}>
  {/* Hero band */}
  <section class="relative overflow-hidden">
    <div class="dot-grid" aria-hidden="true"></div>
    <div
      class="relative mx-auto max-w-7xl px-6 pt-16 pb-12 md:px-10 md:pt-24 md:pb-16 lg:pt-28 lg:pb-20"
    >
      <p class="small-caps text-xs md:text-sm text-[var(--text-muted)] mb-6">
        Governance
      </p>
      <h1
        class="hero-display max-w-5xl text-balance break-words font-display font-semibold tracking-tight text-[var(--text)] text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] leading-[1.1]"
      >
        Stewardship, license, and industry engagement.
      </h1>
      <p
        class="mt-6 md:mt-8 max-w-3xl text-base md:text-lg lg:text-xl text-[var(--text-muted)] leading-relaxed"
      >
        ULC is stewarded by lighting professionals, for everyone who reads a luminaire datasheet during their work. MIT-licensed, with active dialogue with the bodies that govern adjacent standards.
      </p>
    </div>
  </section>

  {/* Full-width industry-dialogue strip — second consumer of the shared
      DialogueStrip (homepage is the first). Renders before the body grid
      because the strip is a <section> and the standards-document register
      reads the dialogue-with framing as a top-of-page credibility beat
      for industry-body visitors. The inline column-bounded variant was
      considered but dropped to avoid repetition; the body prose in the
      Industry engagement section names DIAL/LIA/IES inline already. */}
  <DialogueStrip />

  {/* Body: 2-col on desktop with sticky TOC sidebar, single-col on mobile.
      Mirrors /for-designers + /for-manufacturers chrome composition. */}
  <div class="mx-auto max-w-7xl px-6 md:px-10 pb-24 lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-12">
    <div class="lg:pt-12">
      <StickyToc items={tocItems} />
    </div>

    <article class="long-form pt-10 lg:pt-12 max-w-[68ch]">

      {/* ── 1. STEWARDSHIP ─────────────────────────────────────────────── */}
      <section id="stewardship" aria-labelledby="stewardship-heading">
        <p class="step-num">Stewardship</p>
        <h2 id="stewardship-heading">Stewarded by lighting professionals.</h2>
        <p>
          ULC is stewarded by lighting professionals, for everyone who reads a luminaire datasheet during their work. The audience is everyone who reads a datasheet: lighting designers, interior designers, architects, manufacturers, software vendors, AI tool builders, industry bodies, researchers.
        </p>

        <div class="credential-block" role="group" aria-label="Steward credentials">
          <p class="credential-block__name">Foad Shafighi</p>
          <p class="credential-block__credentials">
            <span>MIES</span><span aria-hidden="true">·</span><span>IALD</span><span aria-hidden="true">·</span><span>CLD</span>
          </p>
          <p class="credential-block__role">A practicing lighting designer working across the United States and the European specification community.</p>
          <p class="credential-block__neg">Not a software vendor. Not a trade body.</p>
        </div>

        {/* LightingAgent.AI disclosure placed before the specifier-side
            structural defense so the disclosure lands before any case for
            the steward is made. Storyboard Step 7 "upfront" framing. */}
        <Callout intent="warning" label="LightingAgent.AI disclosure">
          <p>
            The same founder also runs LightingAgent.AI, the first production consumer of ULC. The structural answer to the conflict is that ULC's repository lives at <code>github.com/ulcspec/ULC</code>, not under any LightingAgent organization. The MIT license and the open Schema Change Proposal process mean anyone can fork, anyone can submit changes, anyone can implement a competing consumer.
          </p>
          <p>
            That choice is permanent at the license layer. The full structural answer is in the <a href="#q-lightingagent" class="link-inline">"Is this just LightingAgent's data layer?"</a> objection below.
          </p>
        </Callout>

        <p>
          The schema's field set, taxonomy, and design priorities reflect specifier-side needs because the steward specifies. The closed-enum taxonomy uses the categories specifiers use. The provenance metadata answers the questions specification audits ask. The metadata-only constraint reflects the IP framing specifiers expect when integrating manufacturer files into a project.
        </p>
      </section>

      {/* ── 2. LICENSE AND GOVERNANCE ──────────────────────────────────── */}
      <section id="license" aria-labelledby="license-heading">
        <p class="step-num">License and governance</p>
        <h2 id="license-heading">MIT-licensed, open Schema Change Proposal process.</h2>
        <p>
          ULC is published under the MIT license. The full text is in <code>LICENSE</code> at the project root and in the spec repository. Anyone can use ULC. Anyone can fork it. Anyone can build commercial products on top of it. No royalty, no warranty, no licensing committee.
        </p>

        <Callout intent="accent" label="The governance document">
          <p>
            The full governance document lives in the spec repository: <a href="https://github.com/ulcspec/ULC/blob/main/GOVERNANCE.md" rel="noopener external" class="link-inline"><code>github.com/ulcspec/ULC/GOVERNANCE.md</code> <span aria-hidden="true">↗</span></a>. It defines who maintains, how decisions are made, how stewardship transitions, and how Schema Change Proposals flow from filing to merge.
          </p>
        </Callout>

        <h3 id="scp-process">The Schema Change Proposal process.</h3>
        <p>
          Schema Change Proposals are the open channel for evolving ULC. Anyone can submit one via the spec repository. SCPs follow a published review flow: filing, public discussion, maintainer review, merge or rejection with rationale. The four canonical reference records in <code>examples/</code> have been the load-bearing input on every schema iteration so far.
        </p>

        <Callout intent="default" label="If the steward steps away">
          <p>
            The standard is structurally able to continue. The MIT license means no single party owns it. The <code>GOVERNANCE.md</code> document defines how stewardship transitions. The SCP process means schema evolution does not depend on one person.
          </p>
          <p>
            Anyone can fork. Anyone can become the next steward. The structural longevity story is the actual safeguard, not the personal one.
          </p>
        </Callout>
      </section>

      {/* ── 3. INDUSTRY ENGAGEMENT ─────────────────────────────────────── */}
      <section id="industry" aria-labelledby="industry-heading">
        <p class="step-num">Industry engagement</p>
        <h2 id="industry-heading">Active dialogue with the bodies that govern adjacent standards.</h2>
        <p>
          ULC is in active dialogue with DIAL (which governs DIALux and GLDF), the LIA, and the IES. ULC describes these relationships as active dialogue, not endorsement. Formal endorsement is a separate, longer process ULC has not pursued at v1.
        </p>

        <h3 id="crosswalks-heading">Planned crosswalks.</h3>
        <p>
          The crosswalks below define how ULC translates to and from the formats that govern adjacent layers of the lighting data stack. All four are planned at v1: ULC v1 ships the standard itself, and crosswalk specs are next in the roadmap because each one requires coordination with its governing body. Row status flips as each crosswalk lands in the spec repository.
        </p>

        <table class="crosswalk-table" aria-label="ULC crosswalk status">
          <thead>
            <tr>
              <th scope="col">Format</th>
              <th scope="col">Governed by</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {crosswalks.map((row) => (
              <tr>
                <th scope="row" class="crosswalk-format">{row.format}</th>
                <td class="crosswalk-governed">{row.governedBy}</td>
                <td>
                  <span class={`cross-status cross-status--${row.status}`}>
                    {crosswalkStatusLabels[row.status]}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      {/* ── 4. GENESIS ─────────────────────────────────────────────────── */}
      <section id="genesis" aria-labelledby="genesis-heading">
        <p class="step-num">Genesis</p>
        <h2 id="genesis-heading">Introduced at the National Lighting Bureau AI Think Tank 2026 in New York.</h2>
        <p>
          The talk framed the data-layer problem behind AI-mediated specifier discovery, named the dual-track activation flywheel, where designers consume and ask their preferred manufacturer reps for ULC files, and manufacturers publish and surface in AI-mediated discovery, and proposed ULC as the open standard the industry needed.
        </p>
      </section>

      {/* ── 5. PILOTS ──────────────────────────────────────────────────── */}
      <section id="pilots" aria-labelledby="pilots-heading">
        <p class="step-num">Pilots</p>
        <h2 id="pilots-heading">Pilot conversations are underway.</h2>
        <p>
          Pilot conversations are underway with manufacturers and software vendors. The earliest pilots shape the schema through the Schema Change Proposal process; later adopters get the standard once it is table-stakes.
        </p>

        <Callout intent="default" label="The canonical adopters register">
          <p>
            The canonical adoption register lives on the homepage at <a href="/#adopters" class="link-inline">/#adopters</a>. At v1 the register is honestly empty; it will populate as manufacturers publish <code>.ulc</code> files for their products. The register is not duplicated here.
          </p>
        </Callout>

        <p class="pilot-cta">
          If you are evaluating a pilot, write directly to the steward:{' '}
          <a
            href="mailto:contact@ulcspec.org?subject=Pilot%20inquiry"
            class="link"
          >contact@ulcspec.org</a>.
        </p>

        <p class="pilot-cross">
          The full manufacturer-track pitch is at{' '}
          <a href="/for-manufacturers" class="link-inline">/for-manufacturers <span aria-hidden="true">→</span></a>. The full designer-track pitch is at{' '}
          <a href="/for-designers" class="link-inline">/for-designers <span aria-hidden="true">→</span></a>.
        </p>
      </section>

      {/* ── 6. THE FAQ ─────────────────────────────────────────────────── */}
      <section id="faq" aria-labelledby="faq-heading">
        <p class="step-num">The FAQ</p>
        <h2 id="faq-heading">Common questions.</h2>
        <FaqAccordion items={faqItems} />
      </section>
    </article>
  </div>

  <CrossLinkFooter links={crossLinks} />
</PageShell>

<style>
  /* ── Long-form prose, governance-document register ──────────────────
     Mirrors /for-designers + /for-manufacturers .long-form so the three
     long-form surfaces share a single prose token system. Drift between
     this block and the two siblings is the explicit risk PR-A2 graduates
     to global.css. Any change here must land on the siblings too until
     PR-A2 ships. */
  .long-form {
    color: var(--text-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .long-form > section {
    margin-top: 4.5rem;
    scroll-margin-top: 5rem;
  }
  .long-form > section:first-child {
    margin-top: 0;
  }
  .long-form p {
    margin: 0 0 1.25rem 0;
    max-width: 68ch;
  }
  .long-form p:last-child {
    margin-bottom: 0;
  }
  .long-form strong {
    color: var(--text);
    font-weight: 600;
  }
  .long-form code {
    font-family: var(--font-mono);
    font-size: 0.95em;
    color: var(--accent-warm);
  }
  .long-form a {
    color: var(--accent-warm);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .long-form a:hover {
    color: var(--accent-warm-deep);
  }

  .step-num {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
    color: var(--text-subtle);
    margin: 0 0 0.625rem 0 !important;
  }

  .long-form h2 {
    font-family: var(--font-display);
    color: var(--text);
    font-size: 1.875rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 1.5rem 0;
    max-width: 28ch;
  }
  @media (min-width: 768px) {
    .long-form h2 {
      font-size: 2.25rem;
    }
  }
  .long-form h3 {
    font-family: var(--font-display);
    color: var(--text);
    font-size: 1.25rem;
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: -0.005em;
    margin: 1.75rem 0 0.75rem 0;
  }
  @media (min-width: 768px) {
    .long-form h3 {
      font-size: 1.375rem;
    }
  }

  /* ── Credential block ──────────────────────────────────────────────
     Single-surface consumer as of 2026-05-16. The pattern is governance-
     specific (designer credentials prominently displayed in a standards-
     document register, not a "meet the founder" SaaS card). Promote to
     a shared CredentialBlock primitive only on a second consumer; the
     /for-designers + /for-manufacturers credential mentions are inline
     prose, not block-callouts, by design. */
  .credential-block {
    margin: 1.75rem 0;
    padding: 1.5rem 1.5rem 1.375rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent-warm);
    border-radius: 8px;
  }
  .credential-block__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 0.375rem 0;
    line-height: 1.25;
  }
  @media (min-width: 768px) {
    .credential-block__name {
      font-size: 1.375rem;
    }
  }
  .credential-block__credentials {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.16em;
    font-size: 0.875rem;
    color: var(--accent-warm);
    margin: 0 0 0.875rem 0 !important;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.625rem;
  }
  .credential-block__credentials span[aria-hidden] {
    color: var(--text-subtle);
  }
  .credential-block__role {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0 0 0.625rem 0 !important;
  }
  .credential-block__neg {
    font-size: 0.9375rem;
    color: var(--text);
    font-weight: 500;
    margin: 0 !important;
  }

  /* ── Crosswalk status table ─────────────────────────────────────────
     Mirrors the .alt-table mobile-stack-to-real-table pattern shared
     across /for-designers + /for-manufacturers. Three-state pill
     (planned / in-progress / landed) lives in CSS classes; the data
     layer carries the union variant. The cross-status pills are
     visually distinct from /for-manufacturers' .status-pill on purpose
     (different domain: crosswalk-progress vs proof-availability).
     PR-A2 may unify these if a third long-form surface lands a third
     status-pill domain. */
  .crosswalk-table {
    margin-top: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-elevated);
    border-collapse: collapse;
    width: 100%;
    display: block;
  }
  .crosswalk-table thead,
  .crosswalk-table tbody,
  .crosswalk-table tr {
    display: block;
  }
  .crosswalk-table thead {
    display: none;
  }
  .crosswalk-table tr {
    border-bottom: 1px solid var(--border);
    padding: 0.875rem 1.125rem;
    display: grid;
    /* 1fr auto: format wraps gracefully in narrow viewports (320px+);
       pill stays bounded on the right. Prevents the wrap-collision
       flagged when format-string length grows (design-lens P1-3). */
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 0.25rem 0.75rem;
    align-items: center;
  }
  .crosswalk-table tr:last-child {
    border-bottom: none;
  }
  .crosswalk-table th[scope='row'],
  .crosswalk-table td {
    font-size: 0.9375rem;
    line-height: 1.5;
    text-align: left;
    color: var(--text-muted);
    font-weight: 400;
  }
  .crosswalk-format {
    grid-row: 1;
    grid-column: 1;
    font-family: var(--font-mono);
    font-size: 0.875rem !important;
    color: var(--text) !important;
    font-weight: 600 !important;
  }
  .crosswalk-governed {
    grid-row: 2;
    grid-column: 1 / -1;
    color: var(--text-subtle);
    font-size: 0.875rem !important;
  }
  .crosswalk-table tr > td:last-child {
    grid-row: 1;
    grid-column: 2;
    justify-self: end;
  }
  @media (min-width: 768px) {
    .crosswalk-table {
      display: table;
    }
    .crosswalk-table thead {
      display: table-header-group;
      background: var(--bg);
    }
    .crosswalk-table tbody {
      display: table-row-group;
    }
    .crosswalk-table tr {
      display: table-row;
      padding: 0;
    }
    .crosswalk-table th,
    .crosswalk-table td {
      display: table-cell;
      padding: 1.125rem 1.25rem;
      vertical-align: middle;
      border-bottom: 1px solid var(--border);
    }
    .crosswalk-table tr:last-child th,
    .crosswalk-table tr:last-child td {
      border-bottom: none;
    }
    .crosswalk-table th[scope='col'] {
      font-variant-caps: all-small-caps;
      letter-spacing: 0.06em;
      font-size: 0.75rem;
      color: var(--text-subtle);
      text-align: left;
      font-weight: 500;
    }
    .crosswalk-format {
      width: 28%;
    }
    .crosswalk-governed {
      color: var(--text-muted);
      font-size: 0.9375rem !important;
    }
  }

  /* ── Cross-status pills ─────────────────────────────────────────────
     Three-state pill with distinct visual reads at a glance:
     - planned     neutral dashed-border, subtle
     - in-progress amber 12% tint, body text color, 40% amber border
     - landed      amber 18% tint, accent-warm text, 55% amber border,
                   weight 600 (the visual peak — "this exists")
     All three clear WCAG AA 4.5:1 in both themes. */
  .cross-status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
