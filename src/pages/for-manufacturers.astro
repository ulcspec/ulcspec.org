<script>
  // Forward-to-team share affordance: third consumer of bindCopyButton.
  // Populates the source span with window.location.href at hydration so
  // the copied link reflects the canonical host the reader is on
  // (Astro.site is not yet set in v1).
  import { bindCopyButton } from '../lib/clipboard';

  const sourceEl = document.getElementById('pilot-share-source');
  if (sourceEl && typeof window !== 'undefined') {
    sourceEl.textContent = window.location.href;
  }
  bindCopyButton({
    buttonId: 'pilot-share-btn',
    sourceId: 'pilot-share-source',
    statusId: 'pilot-share-status',
    copiedAnnouncement: 'Page link copied to clipboard',
    selectFallbackText: 'Link selected. Press Cmd+C / Ctrl+C to copy.',
  });
</script>
