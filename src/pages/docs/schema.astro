---
import PageShell from '../../components/PageShell.astro';
import SpecDocsLayout from '../../components/SpecDocsLayout.astro';
import SpecVersionBadge from '../../components/SpecVersionBadge.astro';
import EditOnGitHub from '../../components/EditOnGitHub.astro';
import Callout from '../../components/Callout.astro';
import { manifestEntryForRouteOrThrow } from '../../lib/spec-sync';

const entry = manifestEntryForRouteOrThrow('/docs/schema');
const upstreamPath = entry.upstreamPath;
---

<PageShell
  title="Schema reference - ULC specification"
  description="ULC JSON Schema (Draft 2020-12). Every field documented with type, required or optional status, description, allowed values, and example."
>
  <SpecDocsLayout>
    <p class="page-eyebrow"><SpecVersionBadge /></p>
    <h1 class="page-h1">Schema reference.</h1>
    <p class="page-intro">
      ULC's JSON Schema (Draft 2020-12) defines every field, type,
      constraint, and enumeration in the format. Each field is documented
      with type, required or optional status, description, allowed values,
      and an example. The schema file itself is served at
      <code>/schema/ulc.json</code> with the
      <code>application/schema+json</code> content-type.
    </p>

    <Callout intent="default" label="Content sync">
      <p>
        Field-by-field reference cards are generated at build from
        <code>{`ulcspec/ULC/${upstreamPath}`}</code>. The generator
        walks the JSON Schema tree and emits one anchor per field
        (type · required · description · allowed values · example).
        Generator + first batch land with the spec-sync content loader.
      </p>
    </Callout>

    <EditOnGitHub upstreamPath={upstreamPath} />
  </SpecDocsLayout>
</PageShell>

<style>
  .page-eyebrow { margin: 0 0 1.25rem 0; }
  .page-h1 {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 1.25rem 0;
  }
  @media (min-width: 768px) { .page-h1 { font-size: 2.75rem; } }
  .page-intro {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0 0 1.5rem 0;
    max-width: 44rem;
  }
  .page-intro code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--accent-warm);
  }
</style>
