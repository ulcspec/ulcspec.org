---
import PageShell from '../../components/PageShell.astro';
import SpecDocsLayout from '../../components/SpecDocsLayout.astro';
import OnThisPage from '../../components/OnThisPage.astro';
import type { Heading } from '../../lib/spec-headings';
import { getTaxonomyGroups, getTaxonomyStats } from '../../lib/taxonomy-reference';

const groups = getTaxonomyGroups();
const { enumCount, valueCount } = getTaxonomyStats();

const headings: Heading[] = groups.map((g) => ({ id: g.id, label: g.title, depth: 2 }));

function searchKey(name: string, title: string, values: readonly string[]): string {
  return [name, title, ...values].join(' ').toLowerCase();
}
---

<PageShell
  title="Taxonomy - ULC specification"
  description="ULC's closed-enum taxonomies. Luminaire categories, mounting types, optical accessories, attestation programs, dimming protocols, source-file types, provenance sources. Every enum with its allowed values and the fields that use it."
>
  <SpecDocsLayout>
    <h1 class="page-h1">Taxonomy.</h1>
    <p class="page-intro">
      ULC's closed-enum taxonomies define the allowed value sets for the
      schema's categorical fields. Each enum is referenced by the fields that
      consume it; a record may only use a value listed here. Adding a value goes
      through the Schema Change Proposal process. This page lists all
      {enumCount} taxonomies and their {valueCount} values.
    </p>

    <div class="tax-filter">
      <label class="tax-filter__label" for="tax-search">Filter</label>
      <input
        type="search"
        id="tax-search"
        class="tax-filter__input"
        placeholder="Filter by name or value (e.g. downlight, dali, lm_79)"
        autocomplete="off"
        spellcheck="false"
        aria-describedby="tax-filter-status"
      />
      <p id="tax-filter-status" class="tax-filter__status" role="status" aria-live="polite"></p>
    </div>

    <div class="tax-groups">
      {groups.map((group) => (
        <section class="tax-group" id={group.id} data-group aria-labelledby={`${group.id}-h`}>
          <h2 id={`${group.id}-h`} class="tax-group__title">{group.title}</h2>
          <div class="tax-group__enums">
            {group.enums.map((e) => (
              <article
                class="tax-enum"
                id={e.anchor}
                data-enum
                data-search={searchKey(e.name, e.title, e.values)}
              >
                <div class="tax-enum__head">
                  <h3 class="tax-enum__name">
                    <a href={`#${e.anchor}`} class="tax-enum__anchor">{e.name}</a>
                  </h3>
                  <span class="tax-enum__count">{e.values.length} values</span>
                </div>
                {e.title && e.title !== e.name && (
                  <p class="tax-enum__title">{e.title}</p>
                )}
                {e.description && <p class="tax-enum__desc">{e.description}</p>}
                <ul class="tax-enum__values">
                  {e.values.map((v) => (
                    <li><code>{v}</code></li>
                  ))}
                </ul>
                {e.usedBy.length > 0 && (
                  <p class="tax-enum__usedby">
                    Used by{' '}
                    {e.usedBy.map((field, i) => (
                      <>{i > 0 ? ', ' : ''}<code>{field}</code></>
                    ))}
                  </p>
                )}
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>

    <p class="tax-empty" data-empty hidden>No taxonomy matches that filter.</p>

    <OnThisPage slot="onThisPage" headings={headings} label="Taxonomies" />
  </SpecDocsLayout>
</PageShell>

<script>
  // Client-side filter: hide enum cards and empty group sections whose searchable
  // text does not contain every whitespace-delimited token of the query. Pure
  // progressive enhancement; without JS the full list renders.
  const input = document.getElementById('tax-search') as HTMLInputElement | null;
  const status = document.getElementById('tax-filter-status');
  const empty = document.querySelector('[data-empty]') as HTMLElement | null;
  const enums = Array.from(document.querySelectorAll<HTMLElement>('[data-enum]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));

  function apply(query: string): void {
    const tokens = query.toLowerCase().split(/\s+/).filter(Boolean);
    let visible = 0;
    for (const el of enums) {
      const hay = el.dataset.search ?? '';
      const match = tokens.every((t) => hay.includes(t));
      el.hidden = !match;
      if (match) visible += 1;
    }
    for (const g of groups) {
      const anyVisible = g.querySelector('[data-enum]:not([hidden])') !== null;
      g.hidden = !anyVisible;
    }
    if (empty) empty.hidden = visible !== 0;
    if (status) {
      status.textContent = tokens.length === 0 ? '' : `${visible} ${visible === 1 ? 'taxonomy' : 'taxonomies'} match`;
    }
  }

  input?.addEventListener('input', () => apply(input.value));
</script>

<style>
  .page-h1 {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 1.25rem 0;
  }
  @media (min-width: 768px) { .page-h1 { font-size: 2.75rem; } }
  .page-intro {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0 0 1.5rem 0;
    max-width: 44rem;
  }

  /* Filter */
  .tax-filter {
    margin: 0 0 2rem 0;
  }
  .tax-filter__label {
    display: block;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    font-size: 0.6875rem;
    color: var(--text-subtle);
    margin: 0 0 0.375rem 0;
  }
  .tax-filter__input {
    width: 100%;
    max-width: 32rem;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--text);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.625rem 0.875rem;
  }
  .tax-filter__input:focus-visible {
    outline: 2px solid var(--accent-warm);
    outline-offset: 1px;
    border-color: var(--accent-warm);
  }
  .tax-filter__status {
    margin: 0.5rem 0 0 0;
    font-size: 0.8125rem;
    color: var(--text-subtle);
    min-height: 1.2em;
  }

  /* Groups */
  .tax-group {
    margin: 0 0 2.75rem 0;
    scroll-margin-top: 1.5rem;
  }
  .tax-group__title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.25;
    margin: 0 0 1.25rem 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .tax-group__enums {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Enum card */
  .tax-enum {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.125rem 1.25rem;
    background: var(--bg-elevated);
    scroll-margin-top: 1.5rem;
  }
  .tax-enum__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .tax-enum__name {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    margin: 0;
  }
  .tax-enum__anchor {
    color: inherit;
    text-decoration: none;
  }
  .tax-enum__anchor:hover {
    color: var(--accent-warm);
  }
  .tax-enum__count {
    flex: none;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.04em;
    font-size: 0.6875rem;
    color: var(--text-subtle);
  }
  .tax-enum__title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    margin: 0.25rem 0 0 0;
  }
  .tax-enum__desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0.5rem 0 0 0;
  }
  .tax-enum__values {
    list-style: none;
    margin: 0.875rem 0 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .tax-enum__values li { margin: 0; }
  .tax-enum__values code {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78125rem;
    color: var(--accent-warm);
    background: color-mix(in oklab, var(--accent-warm) 8%, transparent);
    border: 1px solid color-mix(in oklab, var(--accent-warm) 22%, var(--border));
    border-radius: 5px;
    padding: 0.1875rem 0.4375rem;
    line-height: 1.3;
  }
  .tax-enum__usedby {
    font-size: 0.8125rem;
    color: var(--text-subtle);
    margin: 0.875rem 0 0 0;
    line-height: 1.6;
  }
  .tax-enum__usedby code {
    font-family: var(--font-mono);
    font-size: 0.78125rem;
    color: var(--text-muted);
  }

  .tax-empty {
    font-size: 0.9375rem;
    color: var(--text-subtle);
    padding: 1rem 0;
  }
</style>
