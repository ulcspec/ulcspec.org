---
import PageShell from '../../components/PageShell.astro';
import SpecDocsLayout from '../../components/SpecDocsLayout.astro';
import Callout from '../../components/Callout.astro';
---

<PageShell
  title="Taxonomy - ULC specification"
  description="ULC's closed-enum taxonomies. Luminaire categories, mounting types, optical accessories, attestation programs, dimming protocols, source-file types, provenance sources."
>
  <SpecDocsLayout>
    <h1 class="page-h1">Taxonomy.</h1>
    <p class="page-intro">
      Closed-enum taxonomies cover luminaire categories, mounting types,
      optical accessories, attestation programs, dimming protocols,
      source-file types, and provenance sources. Each enum is referenced
      by the schema fields that consume it. Adding a new enum value goes
      through the Schema Change Proposal process.
    </p>

    <Callout intent="default" label="Reference in progress">
      <p>
        The browsable enum reference is still being built. In the meantime, the
        taxonomy lives in <code>taxonomy.schema.json</code> in the
        <a href="https://github.com/ulcspec/ULC" rel="noopener external">spec repository</a>.
      </p>
    </Callout>
  </SpecDocsLayout>
</PageShell>

<style>
  .page-h1 {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 1.25rem 0;
  }
  @media (min-width: 768px) { .page-h1 { font-size: 2.75rem; } }
  .page-intro {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0 0 1.5rem 0;
    max-width: 44rem;
  }
  .page-intro code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--accent-warm);
  }
</style>
