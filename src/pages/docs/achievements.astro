    font-size: 0.9375rem !important;
    border-left: 2px solid var(--border);
    padding-left: 1rem;
  }

  .cf-levels {
    margin: 1.25rem 0 0 0;
    max-width: 44rem;
  }
  .cf-levels dt {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--accent-warm);
    margin-top: 1.125rem;
  }
  .cf-levels dt:first-child {
    margin-top: 0;
  }
  .cf-levels dt :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .cf-levels dd {
    margin: 0.375rem 0 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .cf-table-wrap {
