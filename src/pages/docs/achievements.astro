  .page-intro {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0 0 1rem 0;
    max-width: 44rem;
  }
  .page-intro :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--text);
  }

  .cf-section {
    margin-top: 3rem;
    scroll-margin-top: 5rem;
  }
