    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 0.875rem 0;
  }
  @media (min-width: 768px) { .cf-h2 { font-size: 1.75rem; } }

  .cf-section p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text);
    margin: 1rem 0 0 0;
    max-width: 44rem;
  }
  .cf-section p:first-of-type {
    margin-top: 0;
  }
  .cf-section strong {
    color: var(--text);
    font-weight: 600;
  }
